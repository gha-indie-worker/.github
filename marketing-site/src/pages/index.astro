---
const features=[
 ["GitHub remains the trigger","Pushes, workflow runs, registry events, HTTP requests, or NATS work items can start the same reviewed build contract."],
 ["No caller shell","Requests select fixed image steps or compiled-in profiles; callers cannot inject command text into the worker."],
 ["Cluster-native execution","nerdctl builds, ECR pushes, kubectl handoff, and optional sandboxed Lambda execution share one Rust control surface."],
 ["Durable coordination","Fiducia locks serialize image builds, Postgres preserves jobs and audit rows, and NATS carries lifecycle and terminal events."],
 ["Bounded artifacts","Profiles use pinned runner images, fixed artifact paths, resource limits, dropped capabilities, and narrower repository allowlists."],
 ["Honest platform limits","Linux covers Android, web, Linux desktop, and browser tests; macOS and Windows jobs are delegated to native runners."],
];
const samples=[
 {id:"profile",label:"build-server.v1 JSON",file:"profile.json",code:`{
  "schemaVersion": "build-server.v1",
  "jobKind": "run-profile",
  "repoUrl": "https://github.com/sonus-auris/sonus-auris-ui.dart.git",
  "gitRef": "main",
  "profile": "flutter-android-debug"
}`,note:"The profile name selects an operator-reviewed image, command sequence, and artifact contract."},
 {id:"deploy",label:"Build + deploy JSON",file:"deploy.json",code:`{
  "schemaVersion": "build-server.v1",
  "jobKind": "build-and-deploy",
  "repoUrl": "https://github.com/example/app.git",
  "gitRef": "main",
  "image": "710156900967.dkr.ecr.us-east-1.amazonaws.com/example-app:dev",
  "contextDir": ".",
  "dockerfile": "Dockerfile",
  "push": true,
  "deploy": {
    "kind": "kustomize",
    "path": "k8s/overlays/ec2",
    "namespace": "default"
  }
}`,note:"Image, repository, namespace, and paths remain allowlisted; deployment never accepts shell text."},
 {id:"curl",label:"HTTP / curl",file:"submit.sh",code:`curl --fail-with-body \
  -X POST https://build.example.com/builds \
  -H "authorization: Bearer $BUILD_SERVER_TOKEN" \
  -H "content-type: application/json" \
  --data-binary @profile.json

curl --fail-with-body \
  -H "authorization: Bearer $BUILD_SERVER_TOKEN" \
  https://build.example.com/builds/$JOB_ID`,note:"Authenticated HTTP submits and observes the same contract used by webhooks and queue intake."},
 {id:"events",label:"NATS subjects",file:"subjects.txt",code:`dd.remote.build_server.requests  # durable work-queue intake
dd.remote.build_server.events    # lifecycle events
dd.remote.build_server.results   # terminal results
dd.remote.build_server.images    # registry image events
dd.remote.events.critical        # alert-worthy failures`,note:"NATS provides asynchronous intake and observability without changing execution authority."},
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="A Rust build control plane that complements GitHub Actions with fixed-profile execution on your own cluster."><meta name="theme-color" content="#08111c"><title>GHA Indie Worker — own the execution</title></head><body>
<header><a class="brand" href="/"><b>IW</b><span>GHA Indie Worker</span></a><nav><a href="#platform">Runtime</a><a href="#clients">Contract</a><a href="https://github.com/gha-indie-worker">GitHub ↗</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">Rust CI/CD control plane · Cluster-native</p><h1>Keep GitHub as the trigger. <em>Own execution.</em></h1><p class="lede">GHA Indie Worker turns reviewed `build-server.v1` documents into bounded image, profile, artifact, and deployment work on your infrastructure—without accepting caller-supplied shell commands.</p><div class="actions"><a class="primary" href="https://github.com/gha-indie-worker/gha-indie-worker.rs">Explore the worker ↗</a><a href="#clients">Inspect the contract</a></div><ul><li>Fixed profiles</li><li>Fiducia locks</li><li>Postgres + NATS</li></ul></div><div class="visual"><span class="grid"></span><div class="core"><small>BUILD CONTRACT</small><strong>build-server.v1</strong><i>reviewed inputs only</i></div><div class="chip c1">TRIGGER<b>GitHub · NATS</b></div><div class="chip c2">EXECUTOR<b>nerdctl · Lambda</b></div><div class="chip c3">STATE<b>Postgres</b></div><div class="chip c4">DELIVERY<b>artifact · GitOps</b></div><svg viewBox="0 0 500 400"><path d="M80 80L250 200L420 80M80 320L250 200L420 320"/></svg></div></section>
<section class="metrics"><div><b>0</b><span>caller shell strings</span></div><div><b>4</b><span>lifecycle subjects</span></div><div><b>2</b><span>executor paths</span></div><div><b>1</b><span>versioned job schema</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Build infrastructure with boundaries</p><h2>Fast enough for daily work. Explicit enough for production review.</h2><p class="intro">The worker is a control surface, not an untrusted-code sandbox. It narrows authority through authentication, allowlists, fixed profiles, direct argv execution, bounded queues, deadlines, and least-privilege Kubernetes access.</p><div class="features">{features.map(([t,b],i)=><article><small>{String(i+1).padStart(2,"0")}</small><h3>{t}</h3><p>{b}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">Integration workbench</p><h2>One build document across HTTP, webhooks, and NATS.</h2><p class="intro">There is not yet a published polyglot client package. These examples expose the real API and event surface without pretending an SDK matrix exists.</p><a class="source" href="https://github.com/gha-indie-worker/gha-indie-worker.rs">Browse the Rust server ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Example</span><select aria-label="Select client language" data-language>{samples.map((s,i)=><option value={s.id} selected={i===0}>{s.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "profile.json"}</code><button data-copy type="button">Copy</button></div>{samples.map((s,i)=><article data-sample={s.id} data-name={s.file} hidden={i!==0}><pre tabindex="0"><code>{s.code}</code></pre><p>{s.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Complement, do not imitate blindly</p><h2>Use GitHub’s events. Run trusted workloads where you control the limits.</h2><a href="https://github.com/gha-indie-worker">Open the organization ↗</a></section></main><footer><span>© 2026 GHA Indie Worker</span><a href="https://github.com/gha-indie-worker/gha-indie-worker.rs">Build server</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((r)=>{const s=r.querySelector('[data-language]'),f=r.querySelector('[data-file]'),c=r.querySelector('[data-copy]'),p=[...r.querySelectorAll('[data-sample]')];const show=(id)=>p.forEach((x)=>{const a=x.dataset.sample===id;x.hidden=!a;if(a)f.textContent=x.dataset.name||''});s?.addEventListener('change',(e)=>show(e.target.value));c?.addEventListener('click',async()=>{const a=p.find((x)=>!x.hidden),t=a?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(t);c.textContent='Copied'}catch{a?.querySelector('pre')?.focus();c.textContent='Select code'}setTimeout(()=>c.textContent='Copy',1200)})});</script>
<style>:root{--accent:#f59e0b;--hot:#22c55e;--ink:#08111c;--muted:#64748b;--paper:#f7faf8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#fefce8,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.7rem;background:var(--ink);color:white;font-size:.72rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:#b45309;font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:47rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #0f172a1b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 50%,#f59e0b45,transparent 38%),linear-gradient(145deg,#071019,#142739);box-shadow:0 35px 90px #0f172a45}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:2.4rem 2.4rem}.visual svg{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:#fbbf2480;stroke-width:2}.core,.chip{position:absolute;z-index:2;display:grid;padding:.82rem;border:1px solid #ffffff24;border-radius:.9rem;background:#0f172bd9;color:#94a3b8;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace;letter-spacing:.07em}.core{top:50%;left:50%;width:13rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong,.chip b{color:white}.core strong{font-size:1.2rem}.core i{font-style:normal}.c1{top:10%;left:7%}.c2{top:10%;right:7%}.c3{bottom:10%;left:7%}.c4{right:7%;bottom:10%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #0f172a16;border-radius:1.15rem;background:#ffffffc7}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #0f172a16}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #0f172a14;border-radius:1.1rem;background:#ffffffc2}.features small{color:#b45309;font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source{display:inline-block;margin-top:1rem;color:#b45309;font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#07101f;color:#dbeafe;box-shadow:0 32px 90px #07101f40}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#0d182b}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#94a3b8;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#111e34;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#94a3b8;font-size:.75rem}.workbench pre{overflow:auto;min-height:22rem;max-height:30rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#94a3b8;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,#d97706,#16a34a);color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
