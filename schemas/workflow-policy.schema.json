{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gha-indie-worker/.github/schemas/workflow-policy.schema.json",
  "title": "gha-indie-worker workflow governance policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "immutable_refs",
    "concurrency_events",
    "scheduled_env",
    "deny_pull_request_target",
    "deny_untrusted_self_hosted",
    "require_checkout_persist_credentials_false"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "immutable_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_sha_length", "docker_digest_length"],
      "properties": {
        "action_sha_length": {"const": 40},
        "docker_digest_length": {"const": 64}
      }
    },
    "concurrency_events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["push", "pull_request", "pull_request_target", "schedule"]
      },
      "allOf": [
        {"contains": {"const": "push"}},
        {"contains": {"const": "pull_request"}},
        {"contains": {"const": "pull_request_target"}},
        {"contains": {"const": "schedule"}}
      ]
    },
    "scheduled_env": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["SCHEDULE_TIMEZONE", "RUN_EVIDENCE_SCHEMA", "MISSED_RUN_POLICY"]
      }
    },
    "deny_pull_request_target": {"const": true},
    "deny_untrusted_self_hosted": {"const": true},
    "require_checkout_persist_credentials_false": {"const": true}
  }
}
